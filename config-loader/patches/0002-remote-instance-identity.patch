@@ -26,6 +26,27 @@ const fastify = Fastify({
   trustProxy: true
 });
 
+// Instance identity distinguishes different Docker hosts using the same port.
+fastify.addHook('onRequest', async (_req, reply) => {
+  reply.header('x-toolhub-node-id', SERVER_NODE_ID);
+});
+
+const isSameHub = async (remoteUrl: string, token?: string | null): Promise<boolean> => {
+  try {
+    const response = await fetch(remoteUrl.trim().replace(/\/+$/, '') + '/', {
+      headers: token ? { 'x-agent-password': token } : {},
+      signal: AbortSignal.timeout(5000),
+      redirect: 'error'
+    });
+    const same = response.headers.get('x-toolhub-node-id') === SERVER_NODE_ID;
+    await response.body?.cancel();
+    return same;
+  } catch {
+    // An offline peer may be configured; runtime x-hub-nodes checks remain active.
+    return false;
+  }
+};
