{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "merge",
        "reset"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "adminPasswordEnv": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "agentSecretEnv": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "rootPrompt": {
          "type": "string"
        },
        "rootPromptFile": {
          "type": "string",
          "minLength": 1
        },
        "rootAppendPrompt": {
          "type": "string"
        },
        "maxLogRetention": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "adminPasswordEnv",
        "agentSecretEnv"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "rootPrompt",
          "rootPromptFile"
        ]
      }
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "config": {
            "type": "object",
            "properties": {
              "codeFileName": {
                "type": "string",
                "minLength": 1
              },
              "runCmd": {
                "type": "string",
                "minLength": 1
              },
              "depFileName": {
                "type": "string"
              },
              "installCmd": {
                "type": "string"
              }
            },
            "required": [
              "codeFileName",
              "runCmd"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "type",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "toolpacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "runner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "isActive": {
            "type": "boolean"
          },
          "appendPrompt": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://"
          },
          "tokenEnv": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "required": [
          "path",
          "url",
          "tokenEnv"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "isActive": {
            "type": "boolean"
          },
          "appendPrompt": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "envFrom": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "stateful": {
            "type": "boolean"
          },
          "syncOnStart": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "settings"
  ],
  "additionalProperties": false
}
