      },
      {
        "name": "Runners Management",
        "slug": "runners",
        "appendPrompt": "Управление средами выполнения (Runners) для скриптов в ToolHub.",
        "type": "LOCAL",
        "tools": [
          {
            "name": "List Runners",
            "slug": "list-runners",
            "agentDescription": "Возвращает список всех доступных сред выполнения (раннеров) в ToolHub с их ID и конфигурациями.",
            "code": "import fs from 'fs';\n\nconst port = process.env.PORT || 3000;\nconst adminPass = process.env.ADMIN_PASSWORD || 'admin';\n\ntry {\n  const res = await fetch(`http://127.0.0.1:${port}/admin/api/runners`, {\n    headers: { 'x-admin-password': adminPass }\n  });\n  const runners = await res.json();\n  fs.writeFileSync('output.json', JSON.stringify({ success: res.ok, count: runners.length, runners }));\n} catch (e: any) {\n  fs.writeFileSync('output.json', JSON.stringify({ success: false, error: e.message }));\n}",
            "packageJson": "",
            "inputSchema": { "type": "object", "properties": {} },
            "outputSchema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "count": { "type": "number" },
                "runners": { "type": "array", "items": { "type": "object" } }
              },
              "required": ["success"]
            },
            "examples": [],
            "timeoutMs": 30000,
            "runnerType": "bun_local"
          },
          {
            "name": "Read Runner",
            "slug": "read-runner",
            "agentDescription": "Возвращает точные данные о конкретной среде выполнения (раннере) по его ID.",
            "code": "import fs from 'fs';\n\nconst input = JSON.parse(fs.readFileSync('input.json', 'utf8') || '{}');\nconst port = process.env.PORT || 3000;\nconst adminPass = process.env.ADMIN_PASSWORD || 'admin';\n\nif (!input.runnerId) {\n  fs.writeFileSync('output.json', JSON.stringify({ success: false, error: 'runnerId is required' }));\n  process.exit(0);\n}\n\ntry {\n  const res = await fetch(`http://127.0.0.1:${port}/admin/api/runners/${input.runnerId}`, {\n    headers: { 'x-admin-password': adminPass }\n  });\n  const runner = await res.json();\n  if (res.ok) {\n    fs.writeFileSync('output.json', JSON.stringify({ success: true, runner }));\n  } else {\n    fs.writeFileSync('output.json', JSON.stringify({ success: false, error: runner.error || 'Runner not found' }));\n  }\n} catch (e: any) {\n  fs.writeFileSync('output.json', JSON.stringify({ success: false, error: e.message }));\n}",
