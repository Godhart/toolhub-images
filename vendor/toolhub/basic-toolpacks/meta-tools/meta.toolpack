            "agentDescription": "Обновляет имя, тип или конфигурацию команды запуска существующего раннера по его ID.",
            "code": "import fs from 'fs';\n\nconst input = JSON.parse(fs.readFileSync('input.json', 'utf8') || '{}');\nconst port = process.env.PORT || 3000;\nconst adminPass = process.env.ADMIN_PASSWORD || 'admin';\nconst baseUrl = `http://127.0.0.1:${port}/admin/api`;\n\nif (!input.runnerId) {\n  fs.writeFileSync('output.json', JSON.stringify({ success: false, error: 'runnerId is required' }));\n  process.exit(0);\n}\n\ntry {\n  const getRes = await fetch(`${baseUrl}/runners/${input.runnerId}`, { headers: { 'x-admin-password': adminPass } });\n  const current = await getRes.json();\n\n  const payload = {\n    ...current,\n    name: input.name || current.name,\n    type: input.type || current.type,\n    description: input.description !== undefined ? input.description : current.description,\n    config: input.config || current.config\n  };\n\n  const res = await fetch(`${baseUrl}/runners/${input.runnerId}`, {\n    method: 'PUT',\n    headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPass },\n    body: JSON.stringify(payload)\n  });\n  const result = await res.json();\n  fs.writeFileSync('output.json', JSON.stringify({ success: res.ok, result }));\n} catch (e: any) {\n  fs.writeFileSync('output.json', JSON.stringify({ success: false, error: e.message }));\n}",
