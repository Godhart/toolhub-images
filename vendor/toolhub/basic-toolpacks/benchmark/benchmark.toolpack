{
  "kind": "TOOLHUB_PACK",
  "version": 1,
  "category": {
    "name": "Benchmark Suite PRO",
    "slug": "bench",
    "appendPrompt": "Промышленный набор бенчмарков ToolHub: CPU, Disk I/O, Outbound Network, System Calls.",
    "type": "LOCAL",
    "remoteUrl": "",
    "remoteToken": "",
    "mcpCommand": "bunx",
    "mcpArgs": "",
    "mcpEnv": {},
    "mcpIsStateful": false,
    "tools": [
      {
        "name": "Bash System Telemetry",
        "slug": "bash-sys",
        "agentDescription": "Замер скорости спавна sh/bash процесса и сбора метрик ОС",
        "code": "echo \"{\\\"success\\\": true, \\\"os\\\": \\\"$(uname -s)\\\", \\\"uptime\\\": \\\"$(uptime -p 2>/dev/null || uptime)\\\", \\\"msg\\\": \\\"$INPUT_MSG\\\"}\" > output.json",
        "packageJson": "",
        "inputSchema": { "type": "object", "properties": { "msg": { "type": "string" } } },
        "outputSchema": { "type": "object", "properties": { "success": { "type": "boolean" } }, "required": ["success"] },
        "examples": [{ "input": { "msg": "test" }, "output": { "success": true } }],
        "timeoutMs": 5000,
        "isMcpProxy": false,
        "runnerType": "bash_local",
        "runnerName": "Bash"
      },
      {
        "name": "Bun CPU Cruncher",
        "slug": "bun-cpu",
        "agentDescription": "Замер вычислений нативного Bun V8 (100k итераций хэширования/математики)",
        "code": "import fs from 'fs';\nconst input = JSON.parse(fs.readFileSync('input.json', 'utf8') || '{}');\nconst iters = input.iters || 50000;\nlet acc = 0;\nfor (let i = 0; i < iters; i++) { acc = (acc + (i ^ (i % 7))) & 0xFFFFFF; }\nfs.writeFileSync('output.json', JSON.stringify({ success: true, iters, acc }));",
        "packageJson": "",
        "inputSchema": { "type": "object", "properties": { "iters": { "type": "number" } } },
        "outputSchema": { "type": "object", "properties": { "success": { "type": "boolean" }, "acc": { "type": "number" } }, "required": ["success"] },
        "examples": [{ "input": { "iters": 1000 }, "output": { "success": true, "acc": 12345 } }],
        "timeoutMs": 5000,
        "isMcpProxy": false,
        "runnerType": "bun_local",
        "runnerName": "Bun (TypeScript/JavaScript)"
      },
      {
        "name": "Bun Heavy Disk I/O",
        "slug": "bun-io",
        "agentDescription": "Тест дисковой подсистемы: параллельная запись и чтение 25 файлов в воркспейсе",
        "code": "import fs from 'fs';\nimport path from 'path';\nconst count = 25;\nfor (let i = 0; i < count; i++) {\n  fs.writeFileSync(`temp_${i}.dat`, `PAYLOAD_BLOCK_${i}_` + 'X'.repeat(256));\n}\nlet readBytes = 0;\nfor (let i = 0; i < count; i++) {\n  readBytes += fs.readFileSync(`temp_${i}.dat`).length;\n}\nfs.writeFileSync('output.json', JSON.stringify({ success: true, filesWritten: count, totalBytes: readBytes }));",
        "packageJson": "",
        "inputSchema": { "type": "object", "properties": {} },
        "outputSchema": { "type": "object", "properties": { "success": { "type": "boolean" }, "totalBytes": { "type": "number" } }, "required": ["success"] },
        "examples": [{ "input": {}, "output": { "success": true, "filesWritten": 25, "totalBytes": 6800 } }],
        "timeoutMs": 5000,
        "isMcpProxy": false,
        "runnerType": "bun_local",
        "runnerName": "Bun (TypeScript/JavaScript)"
      },
      {
        "name": "Python Crypto SHA256",
        "slug": "py-crypto",
        "agentDescription": "Замер скорости Python 3: парсинг JSON и хеширование 500 блоков",
        "code": "import json, hashlib\nwith open('input.json', 'r') as f:\n    data = json.load(f)\nseed = data.get('seed', 'toolhub-benchmark')\nh = seed.encode()\nfor _ in range(500):\n    h = hashlib.sha256(h).digest()\nwith open('output.json', 'w') as f:\n    json.dump({'success': True, 'finalHex': h.hex()[:16]}, f)",
        "packageJson": "",
        "inputSchema": { "type": "object", "properties": { "seed": { "type": "string" } } },
        "outputSchema": { "type": "object", "properties": { "success": { "type": "boolean" }, "finalHex": { "type": "string" } }, "required": ["success"] },
        "examples": [{ "input": { "seed": "test" }, "output": { "success": true, "finalHex": "abcdef" } }],
        "timeoutMs": 5000,
        "isMcpProxy": false,
        "runnerType": "python_local",
        "runnerName": "Python 3"
      }
    ],
    "children": []
  }
}