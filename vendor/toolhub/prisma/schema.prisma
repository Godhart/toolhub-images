generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String
  isActive      Boolean        @default(true)
  fullPath      String         @unique
  parentId      Int?
  appendPrompt  String?
  
  type          String         @default("LOCAL") // LOCAL, REMOTE, MCP
  
  // FEDERATION
  remoteUrl     String?
  remoteToken   String?
  
  // MCP
  mcpCommand    String?        
  mcpArgs       String?        
  mcpEnv        String?        
  mcpToolsCache String?        
  mcpIsStateful Boolean        @default(false)
  
  parent        Category?      @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryToCategory")
  tools         ToolCategory[]
  createdAt     DateTime       @default(now())
}

model Tool {
  id               Int            @id @default(autoincrement())

  isMcpProxy       Boolean        @default(false)
  mcpMethodName    String?        
  mcpSourceId      Int?           

  name             String
  slug             String
  descriptionMd    String?        
  agentDescription String         
  code             String?        
  packageJson      String?        
  inputSchema      String?        
  outputSchema     String?        
  examples         String?        @default("[]") 
  isActive         Boolean        @default(true)
  timeoutMs        Int            @default(30000)
  runnerId         Int
  runner           Runner         @relation(fields: [runnerId], references: [id])
  categories       ToolCategory[]
  history          ToolVersion[]
  logs             ExecutionLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ToolVersion {
  id        Int      @id @default(autoincrement())
  toolId    Int
  code      String?
  inputSchema String?
  agentDescription String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ToolCategory {
  id         Int      @id @default(autoincrement())
  toolId     Int
  categoryId Int

  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([toolId, categoryId])
}

model Runner {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  type        String   
  description String?
  config      String?  
  isActive    Boolean  @default(true)

  tools       Tool[]
}

model SystemSetting {
  id               Int      @id @default(autoincrement())
  rootPrompt       String 
  rootAppendPrompt String?  @default("Root folder of the Toolhub. Use listTools(\"/folder\") to navigate.")
  agentSecret      String   @default("123")
  adminPassword    String   @default("admin")
  maxLogRetention  Int      @default(1000)
}

model ExecutionLog {
  id          Int      @id @default(autoincrement())
  toolId      Int?
  path        String
  durationMs  Int
  success     Boolean
  payload     String?
  result      String?
  error       String?
  callerIp    String?
  createdAt   DateTime @default(now())
  tool        Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
}