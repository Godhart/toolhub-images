{
  "name": "okf-workspace",
  "version": "0.2.0",
  "description": "Versioned artifacts and documentation over OKF MCP",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "okf-workspace": "dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "schemas": "node scripts/export-schemas.mjs",
    "demo": "node --import tsx examples/demo-v2.ts"
  },
  "dependencies": {
    "@copperbox/okf-mcp": "2.1.0",
    "@modelcontextprotocol/sdk": "1.18.0",
    "diff": "8.0.2",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.8.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "4.23.0", "typescript": "5.8.3" }
}
