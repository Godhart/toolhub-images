{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "default": "HEAD"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/domains/items/properties/id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "artifact"
            ]
          },
          "domain": {
            "$ref": "#/properties/domains/items/properties/id"
          },
          "repository": {
            "$ref": "#/properties/domains/items/properties/id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "card": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "object",
                    "properties": {
                      "repository": {
                        "$ref": "#/properties/domains/items/properties/id"
                      },
                      "path": {
                        "$ref": "#/properties/nodes/items/properties/path"
                      },
                      "artifact_id": {
                        "$ref": "#/properties/domains/items/properties/id"
                      }
                    },
                    "required": [
                      "repository",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "full",
                      "delegated",
                      "minimal"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "document": {
                          "$ref": "#/properties/domains/items/properties/id"
                        },
                        "section": {
                          "$ref": "#/properties/domains/items/properties/id"
                        }
                      },
                      "required": [
                        "document"
                      ],
                      "additionalProperties": false
                    },
                    "default": []
                  }
                },
                "required": [
                  "subject",
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "string"
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "depends_on",
                    "documents",
                    "implements",
                    "references",
                    "related_to"
                  ]
                },
                "target": {
                  "$ref": "#/properties/domains/items/properties/id"
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "section": {
                  "$ref": "#/properties/domains/items/properties/id"
                },
                "source_section": {
                  "$ref": "#/properties/domains/items/properties/id"
                }
              },
              "required": [
                "type",
                "target"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "id",
          "kind",
          "domain",
          "repository",
          "path",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/properties/domains/items/properties/id"
          },
          "prefix": {
            "anyOf": [
              {
                "$ref": "#/properties/nodes/items/properties/path"
              },
              {
                "type": "string",
                "const": ""
              }
            ],
            "default": ""
          },
          "domain": {
            "$ref": "#/properties/domains/items/properties/id"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prefix": {
                  "$ref": "#/properties/nodes/items/properties/path"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "prefix",
                "reason"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "repository",
          "domain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repositories",
    "domains",
    "nodes"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
