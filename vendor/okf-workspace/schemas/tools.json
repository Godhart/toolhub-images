{
  "migration_prepare": {
    "description": "Prepare a v0.1 to v0.2 snapshot migration. Old snapshots remain unchanged; apply with changes_apply.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "dependencies_import_prepare": {
    "description": "Validate byte hashes, map source roots and prepare provenance-aware dependency import. Partial reports never remove observations. Apply with changes_apply.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "const": "dependency-manifest"
            },
            "version": {
              "type": "string",
              "const": "1.0"
            },
            "producer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "analyzer": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version",
                "analyzer"
              ],
              "additionalProperties": false
            },
            "scope": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                },
                "area": {
                  "type": "string",
                  "minLength": 1
                },
                "configuration": {
                  "type": "object",
                  "additionalProperties": {},
                  "default": {}
                }
              },
              "required": [
                "project",
                "profile",
                "area"
              ],
              "additionalProperties": false
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "revision": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "nodes": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "kind": {
                        "type": "string",
                        "const": "file"
                      },
                      "source": {
                        "$ref": "#/properties/idempotency_key"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_hash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "source",
                      "path",
                      "content_hash"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                      },
                      "kind": {
                        "type": "string",
                        "const": "symbol"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file": {
                        "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                      },
                      "attributes": {
                        "type": "object",
                        "additionalProperties": {},
                        "default": {}
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "name",
                      "file"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                      },
                      "kind": {
                        "type": "string",
                        "const": "external"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uri": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dependent": {
                    "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                  },
                  "dependency": {
                    "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                  },
                  "relation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "precision": {
                        "type": "string",
                        "enum": [
                          "file",
                          "symbol",
                          "line"
                        ]
                      }
                    },
                    "required": [
                      "file",
                      "precision"
                    ],
                    "additionalProperties": false
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "dependent",
                  "dependency",
                  "relation"
                ],
                "additionalProperties": false
              }
            },
            "coverage": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "complete",
                    "partial"
                  ]
                },
                "files": {
                  "type": "array",
                  "items": {
                    "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/id"
                  }
                },
                "relation_types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "files",
                "relation_types",
                "limitations"
              ],
              "additionalProperties": false
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "severity",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "format",
            "version",
            "producer",
            "scope",
            "sources",
            "nodes",
            "edges",
            "coverage",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        "mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "repository": {
                "$ref": "#/properties/idempotency_key"
              },
              "prefix": {
                "anyOf": [
                  {
                    "$ref": "#/properties/manifest/properties/nodes/items/anyOf/0/properties/path"
                  },
                  {
                    "type": "string",
                    "const": ""
                  }
                ],
                "default": ""
              }
            },
            "required": [
              "repository"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "manifest",
        "mapping"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "dependencies_sources": {
    "description": "List analysis profiles, completeness and freshness against immutable source bytes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "dependencies_graph": {
    "description": "Get dependent/dependency graph and original entity observations. Manual and imported provenance remain separate.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "analysis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          }
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "dependencies_set_prepare": {
    "description": "Replace manual dependencies of one registered dependent. Imported observations remain unchanged.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "dependent": {
          "$ref": "#/properties/idempotency_key"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dependency": {
                "$ref": "#/properties/idempotency_key"
              },
              "relation": {
                "type": "string",
                "const": "depends_on",
                "default": "depends_on"
              }
            },
            "required": [
              "dependency"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "dependent",
        "dependencies"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "documentation_links_set_prepare": {
    "description": "Replace documented subjects of a document with explicit document/subject roles.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "document": {
          "$ref": "#/properties/idempotency_key"
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/properties/idempotency_key"
          }
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "document",
        "subjects"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "nodes_register_prepare": {
    "description": "Register an existing tracked UTF-8 file or OKF document without rewriting its bytes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "node": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/properties/idempotency_key"
            },
            "kind": {
              "type": "string",
              "enum": [
                "document",
                "artifact"
              ]
            },
            "domain": {
              "$ref": "#/properties/idempotency_key"
            },
            "repository": {
              "$ref": "#/properties/idempotency_key"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "card": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "subject": {
                      "type": "object",
                      "properties": {
                        "repository": {
                          "$ref": "#/properties/idempotency_key"
                        },
                        "path": {
                          "$ref": "#/properties/node/properties/path"
                        },
                        "artifact_id": {
                          "$ref": "#/properties/idempotency_key"
                        }
                      },
                      "required": [
                        "repository",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "full",
                        "delegated",
                        "minimal"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "document": {
                            "$ref": "#/properties/idempotency_key"
                          },
                          "section": {
                            "$ref": "#/properties/idempotency_key"
                          }
                        },
                        "required": [
                          "document"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "subject",
                    "mode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "domain",
            "repository",
            "path",
            "title",
            "description"
          ],
          "additionalProperties": false
        },
        "expected_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "node",
        "expected_hash"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "coverage_set_prepare": {
    "description": "Declare file coverage roots and explicit exclusions with reasons.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "$ref": "#/properties/idempotency_key"
              },
              "prefix": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "string",
                    "const": ""
                  }
                ],
                "default": ""
              },
              "domain": {
                "$ref": "#/properties/idempotency_key"
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "$ref": "#/properties/coverage/items/properties/prefix/anyOf/0"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "prefix",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "repository",
              "domain"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "coverage"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "documentation_issue_prepare": {
    "description": "Record a confirmed documentation mismatch. Creates an update task and review cause.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "document": {
          "$ref": "#/properties/idempotency_key"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "document",
        "reason"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "documentation_plan": {
    "description": "Plan create_card/complete_card/review/update/repair_reference/retire/refresh_analysis/resolve_mapping tasks. Stable deduplicated keys; since_snapshot returns task delta.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "since_snapshot": {
          "$ref": "#/properties/snapshot"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "create_card",
            "complete_card",
            "review",
            "update",
            "repair_reference",
            "retire",
            "refresh_analysis",
            "resolve_mapping"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "documentation_coverage": {
    "description": "Report all in-scope Git files, card coverage and exclusions without recursively requiring cards for card documents.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "snapshot_get": {
    "description": "Get a coherent snapshot ID, repository revisions and domains. Pin this ID on subsequent reads.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "domains_list": {
    "description": "List domain descriptions and organization rules.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "catalog_list": {
    "description": "List registered documents and artifacts; filter pending reviews.",
    "input_schema": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "artifact",
            "document"
          ]
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "docs_search": {
    "description": "Search documentation using OKF. Returns stable document IDs and review status.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "nodes_get": {
    "description": "Read a document or artifact. Start with brief/outline; sections use explicit stable IDs. Artifact views: brief/full. at_hash resolves a pinned dependency in snapshot history.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "view": {
          "type": "string",
          "enum": [
            "brief",
            "summary",
            "outline",
            "sections",
            "full"
          ],
          "default": "brief"
        },
        "section_ids": {
          "type": "array",
          "items": {
            "$ref": "#/properties/id"
          },
          "default": []
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "at_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "graph_query": {
    "description": "Get typed dependencies or reverse dependencies, including cross-domain edges. Pin snapshot for repeatable traversal.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "dependencies",
            "dependents"
          ],
          "default": "dependencies"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 1
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "nodes_related": {
    "description": "Find neighbors and indirectly related nodes with explicit reasons; no embeddings.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "files_list": {
    "description": "List actual tracked repository files, including unregistered files and assets. Git object IDs are distinct from SHA256 content_hash.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "changes_prepare": {
    "description": "Prepare documentation and/or text artifact operations without publishing. Requires base snapshot and expected hashes. Returns diff and candidate snapshot. New review causes are not automatically cleared.",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "operations": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "replace"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "patch"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  },
                  "patch": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash",
                  "patch"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "replace_section"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  },
                  "section_id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash",
                  "section_id",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "create"
                  },
                  "node": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/properties/idempotency_key"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "document",
                          "artifact"
                        ]
                      },
                      "domain": {
                        "$ref": "#/properties/idempotency_key"
                      },
                      "repository": {
                        "$ref": "#/properties/idempotency_key"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      },
                      "card": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "subject": {
                                "type": "object",
                                "properties": {
                                  "repository": {
                                    "$ref": "#/properties/idempotency_key"
                                  },
                                  "path": {
                                    "$ref": "#/properties/operations/items/anyOf/3/properties/node/properties/path"
                                  },
                                  "artifact_id": {
                                    "$ref": "#/properties/idempotency_key"
                                  }
                                },
                                "required": [
                                  "repository",
                                  "path"
                                ],
                                "additionalProperties": false
                              },
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "full",
                                  "delegated",
                                  "minimal"
                                ]
                              },
                              "reason": {
                                "type": "string"
                              },
                              "references": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "document": {
                                      "$ref": "#/properties/idempotency_key"
                                    },
                                    "section": {
                                      "$ref": "#/properties/idempotency_key"
                                    }
                                  },
                                  "required": [
                                    "document"
                                  ],
                                  "additionalProperties": false
                                },
                                "default": []
                              }
                            },
                            "required": [
                              "subject",
                              "mode"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "domain",
                      "repository",
                      "path",
                      "title",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "node",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "move"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  },
                  "path": {
                    "$ref": "#/properties/operations/items/anyOf/3/properties/node/properties/path"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "delete"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "metadata"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "card": {
                    "anyOf": [
                      {
                        "$ref": "#/properties/operations/items/anyOf/3/properties/node/properties/card/anyOf/0"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "review"
                  },
                  "id": {
                    "$ref": "#/properties/idempotency_key"
                  },
                  "expected_hash": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/expected_hash"
                  },
                  "reason_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/idempotency_key"
                    },
                    "minItems": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "action",
                  "id",
                  "expected_hash",
                  "reason_ids",
                  "evidence",
                  "actor"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "base_snapshot",
        "idempotency_key",
        "message",
        "operations"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "changes_apply": {
    "description": "Publish a prepared change through one atomic snapshot pointer update. Does not push remote repositories or modify imported worktrees.",
    "input_schema": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        }
      },
      "required": [
        "change_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "changes_get": {
    "description": "Read a change journal and reconcile publication after a crash.",
    "input_schema": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        }
      },
      "required": [
        "change_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "changes_discard": {
    "description": "Discard an unpublished change. Applied snapshots remain immutable.",
    "input_schema": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        }
      },
      "required": [
        "change_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "catalog_validate": {
    "description": "Check registered IDs, paths, relations, stable sections, document format and content hashes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "sources_status": {
    "description": "Compare source Git refs with managed snapshot revisions. Reports divergence; does not import or merge it.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}
