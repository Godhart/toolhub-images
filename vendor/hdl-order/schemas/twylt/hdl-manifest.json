{
  "format_version": "1.8",
  "name": "hdl-manifest",
  "version": "0.7.0",
  "description": "Export dependency-manifest 1.0 as a JSON object for OKF import; coverage is partial.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "hdl-order[twylt]==0.7.0\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "root": {
        "description": "HDL project directory; each immediate subdirectory is a library. Relative to process cwd.",
        "minLength": 1,
        "title": "Root",
        "type": "string"
      },
      "config": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional TOML file with explicit dependencies; relative to process cwd.",
        "title": "Config"
      },
      "include_dirs": {
        "description": "Ordered additional include directories; relative to process cwd.",
        "items": {
          "type": "string"
        },
        "title": "Include Dirs",
        "type": "array"
      },
      "defines": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Preprocessor definitions, for example {SIM: '1'}.",
        "title": "Defines",
        "type": "object"
      },
      "allow_missing_includes": {
        "default": false,
        "description": "Report unresolved includes instead of aborting.",
        "title": "Allow Missing Includes",
        "type": "boolean"
      },
      "project_id": {
        "description": "Stable project identity in dependency-manifest scope.",
        "minLength": 1,
        "title": "Project Id",
        "type": "string"
      },
      "analysis_profile": {
        "default": "default",
        "description": "Analysis profile, e.g. simulation or synthesis.",
        "minLength": 1,
        "title": "Analysis Profile",
        "type": "string"
      }
    },
    "required": [
      "root",
      "project_id"
    ],
    "title": "ManifestInputTWYLTStrict",
    "type": "object",
    "$id": "HDLManifestInput",
    "x-schema-version": "1.0.0"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "manifest": {
        "additionalProperties": false,
        "description": "Unmodified dependency-manifest 1.0 object, ready for dependencies_import_prepare.manifest.",
        "properties": {
          "format": {
            "const": "dependency-manifest",
            "type": "string"
          },
          "version": {
            "const": "1.0",
            "type": "string"
          },
          "producer": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "analyzer": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "analyzer"
            ],
            "type": "object"
          },
          "scope": {
            "additionalProperties": false,
            "properties": {
              "project": {
                "minLength": 1,
                "type": "string"
              },
              "profile": {
                "minLength": 1,
                "type": "string"
              },
              "area": {
                "minLength": 1,
                "type": "string"
              },
              "configuration": {
                "additionalProperties": {},
                "default": {},
                "type": "object"
              }
            },
            "required": [
              "project",
              "profile",
              "area"
            ],
            "type": "object"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "nodes": {
            "items": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "file",
                      "type": "string"
                    },
                    "source": {
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
                      "type": "string"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "content_hash": {
                      "pattern": "^sha256:[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "source",
                    "path",
                    "content_hash"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "symbol",
                      "type": "string"
                    },
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "file": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "attributes": {
                      "additionalProperties": {},
                      "default": {},
                      "type": "object"
                    },
                    "line": {
                      "exclusiveMinimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name",
                    "file"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "external",
                      "type": "string"
                    },
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "uri": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "edges": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dependent": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "dependency": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "relation": {
                  "minLength": 1,
                  "type": "string"
                },
                "evidence": {
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "line": {
                      "exclusiveMinimum": 0,
                      "type": "integer"
                    },
                    "precision": {
                      "enum": [
                        "file",
                        "symbol",
                        "line"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "file",
                    "precision"
                  ],
                  "type": "object"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "dependent",
                "dependency",
                "relation"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "coverage": {
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ],
                "type": "string"
              },
              "files": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "relation_types": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "limitations": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "status",
              "files",
              "relation_types",
              "limitations"
            ],
            "type": "object"
          },
          "diagnostics": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "severity": {
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ],
                  "type": "string"
                },
                "code": {
                  "minLength": 1,
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "severity",
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "format",
          "version",
          "producer",
          "scope",
          "sources",
          "nodes",
          "edges",
          "coverage",
          "diagnostics"
        ],
        "title": "Manifest",
        "type": "object"
      }
    },
    "required": [
      "manifest"
    ],
    "title": "ManifestOutputTWYLTStrict",
    "type": "object",
    "$id": "HDLManifestOutput",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "root": "examples/twylt-empty",
        "project_id": "empty-demo"
      },
      "output": {
        "manifest": {
          "format": "dependency-manifest",
          "version": "1.0",
          "producer": {
            "name": "hdl-order",
            "version": "0.7.0",
            "analyzer": "hdl-order-syntactic"
          },
          "scope": {
            "project": "empty-demo",
            "profile": "default",
            "area": "hdl",
            "configuration": {
              "defines": {},
              "include_roots": [
                "rtl"
              ],
              "include_search": [],
              "explicit_dependencies": []
            }
          },
          "sources": [
            {
              "id": "rtl"
            }
          ],
          "nodes": [],
          "edges": [],
          "coverage": {
            "status": "partial",
            "files": [],
            "relation_types": [],
            "limitations": [
              "HDL symbol edges are syntactic observations, not the complete VUnit semantic graph.",
              "Unresolved symbol references may be absent. Missing edges must not delete previous observations."
            ]
          },
          "diagnostics": []
        }
      }
    }
  ]
}
