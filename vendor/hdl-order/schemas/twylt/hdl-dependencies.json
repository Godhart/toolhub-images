{
  "format_version": "1.8",
  "name": "hdl-dependencies",
  "version": "0.7.0",
  "description": "List include and explicit file dependencies; optionally explain one project file.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "hdl-order[twylt]==0.7.0\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "root": {
        "description": "HDL project directory; each immediate subdirectory is a library. Relative to process cwd.",
        "minLength": 1,
        "title": "Root",
        "type": "string"
      },
      "config": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional TOML file with explicit dependencies; relative to process cwd.",
        "title": "Config"
      },
      "include_dirs": {
        "description": "Ordered additional include directories; relative to process cwd.",
        "items": {
          "type": "string"
        },
        "title": "Include Dirs",
        "type": "array"
      },
      "defines": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Preprocessor definitions, for example {SIM: '1'}.",
        "title": "Defines",
        "type": "object"
      },
      "allow_missing_includes": {
        "default": false,
        "description": "Report unresolved includes instead of aborting.",
        "title": "Allow Missing Includes",
        "type": "boolean"
      },
      "file": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional project-relative file to explain. Omit for all includes and explicit dependencies.",
        "title": "File"
      }
    },
    "required": [
      "root"
    ],
    "title": "DependenciesInputTWYLTStrict",
    "type": "object",
    "$id": "HDLDependenciesInput",
    "x-schema-version": "1.0.0"
  },
  "outputSchema": {
    "$defs": {
      "ExplicitEdgeTWYLTStrict": {
        "additionalProperties": false,
        "properties": {
          "dependent": {
            "title": "Dependent",
            "type": "string"
          },
          "dependency": {
            "title": "Dependency",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": [
          "dependent",
          "dependency"
        ],
        "title": "ExplicitEdgeTWYLTStrict",
        "type": "object"
      },
      "IncludeEdgeTWYLTStrict": {
        "additionalProperties": false,
        "properties": {
          "dependent": {
            "title": "Dependent",
            "type": "string"
          },
          "dependency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dependency"
          },
          "spelling": {
            "title": "Spelling",
            "type": "string"
          },
          "line": {
            "title": "Line",
            "type": "integer"
          }
        },
        "required": [
          "dependent",
          "dependency",
          "spelling",
          "line"
        ],
        "title": "IncludeEdgeTWYLTStrict",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "includes": {
        "items": {
          "$ref": "#/$defs/IncludeEdgeTWYLTStrict"
        },
        "title": "Includes",
        "type": "array"
      },
      "explicit": {
        "items": {
          "$ref": "#/$defs/ExplicitEdgeTWYLTStrict"
        },
        "title": "Explicit",
        "type": "array"
      },
      "completeness": {
        "const": "include-and-explicit-only",
        "default": "include-and-explicit-only",
        "title": "Completeness",
        "type": "string"
      },
      "explanation": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Explanation"
      }
    },
    "required": [
      "includes",
      "explicit"
    ],
    "title": "DependenciesOutputTWYLTStrict",
    "type": "object",
    "$id": "HDLDependenciesOutput",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "root": "examples/twylt-empty"
      },
      "output": {
        "includes": [],
        "explicit": [],
        "completeness": "include-and-explicit-only",
        "explanation": null
      }
    }
  ]
}
