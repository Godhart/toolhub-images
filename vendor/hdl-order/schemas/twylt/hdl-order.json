{
  "format_version": "1.8",
  "name": "hdl-order",
  "version": "0.7.0",
  "description": "Compute HDL compilation order across libraries; optionally render plain, CSV or ModelSim commands.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "hdl-order[twylt]==0.7.0\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "root": {
        "description": "HDL project directory; each immediate subdirectory is a library. Relative to process cwd.",
        "minLength": 1,
        "title": "Root",
        "type": "string"
      },
      "config": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional TOML file with explicit dependencies; relative to process cwd.",
        "title": "Config"
      },
      "include_dirs": {
        "description": "Ordered additional include directories; relative to process cwd.",
        "items": {
          "type": "string"
        },
        "title": "Include Dirs",
        "type": "array"
      },
      "defines": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Preprocessor definitions, for example {SIM: '1'}.",
        "title": "Defines",
        "type": "object"
      },
      "allow_missing_includes": {
        "default": false,
        "description": "Report unresolved includes instead of aborting.",
        "title": "Allow Missing Includes",
        "type": "boolean"
      },
      "render": {
        "anyOf": [
          {
            "enum": [
              "plain",
              "csv",
              "modelsim"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional additional rendered compile-order text. No commands are executed.",
        "title": "Render"
      }
    },
    "required": [
      "root"
    ],
    "title": "OrderInputTWYLTStrict",
    "type": "object",
    "$id": "HDLOrderInput",
    "x-schema-version": "1.0.0"
  },
  "outputSchema": {
    "$defs": {
      "CompilationUnitTWYLTStrict": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "library": {
            "title": "Library",
            "type": "string"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "library",
          "file",
          "type"
        ],
        "title": "CompilationUnitTWYLTStrict",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "compile_order": {
        "items": {
          "$ref": "#/$defs/CompilationUnitTWYLTStrict"
        },
        "title": "Compile Order",
        "type": "array"
      },
      "defines": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Defines",
        "type": "object"
      },
      "headers": {
        "items": {
          "type": "string"
        },
        "title": "Headers",
        "type": "array"
      },
      "rendered": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rendered"
      }
    },
    "required": [
      "compile_order",
      "defines",
      "headers"
    ],
    "title": "OrderOutputTWYLTStrict",
    "type": "object",
    "$id": "HDLOrderOutput",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "root": "examples/twylt-empty"
      },
      "output": {
        "compile_order": [],
        "defines": {},
        "headers": [],
        "rendered": null
      }
    }
  ]
}
