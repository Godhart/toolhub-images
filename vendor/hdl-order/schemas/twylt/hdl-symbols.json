{
  "format_version": "1.8",
  "name": "hdl-symbols",
  "version": "0.7.0",
  "description": "List HDL design-unit declarations with library, owner and source location.",
  "requirements": {
    "tool": "pip",
    "format": "requirements.txt",
    "content": "hdl-order[twylt]==0.7.0\n"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "root": {
        "description": "HDL project directory; each immediate subdirectory is a library. Relative to process cwd.",
        "minLength": 1,
        "title": "Root",
        "type": "string"
      },
      "config": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional TOML file with explicit dependencies; relative to process cwd.",
        "title": "Config"
      },
      "include_dirs": {
        "description": "Ordered additional include directories; relative to process cwd.",
        "items": {
          "type": "string"
        },
        "title": "Include Dirs",
        "type": "array"
      },
      "defines": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Preprocessor definitions, for example {SIM: '1'}.",
        "title": "Defines",
        "type": "object"
      },
      "allow_missing_includes": {
        "default": false,
        "description": "Report unresolved includes instead of aborting.",
        "title": "Allow Missing Includes",
        "type": "boolean"
      }
    },
    "required": [
      "root"
    ],
    "title": "AnalysisInputTWYLTStrict",
    "type": "object",
    "$id": "HDLSymbolsInput",
    "x-schema-version": "1.0.0"
  },
  "outputSchema": {
    "$defs": {
      "SymbolTWYLTStrict": {
        "additionalProperties": false,
        "properties": {
          "library": {
            "title": "Library",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Owner"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "line": {
            "title": "Line",
            "type": "integer"
          }
        },
        "required": [
          "library",
          "kind",
          "name",
          "file",
          "line"
        ],
        "title": "SymbolTWYLTStrict",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "symbols": {
        "items": {
          "$ref": "#/$defs/SymbolTWYLTStrict"
        },
        "title": "Symbols",
        "type": "array"
      }
    },
    "required": [
      "symbols"
    ],
    "title": "SymbolsOutputTWYLTStrict",
    "type": "object",
    "$id": "HDLSymbolsOutput",
    "x-schema-version": "1.0.0"
  },
  "few_shots": [
    {
      "input": {
        "root": "examples/twylt-empty"
      },
      "output": {
        "symbols": []
      }
    }
  ]
}
