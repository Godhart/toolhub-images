TOOLHUB_ADMIN_PASSWORD=replace-with-your-admin-password
TOOLHUB_AGENT_PASSWORD=replace-with-your-agent-password
TOOLHUB_SEED_LANG=ru

# Cooperative policy: enabled in Hub images, including all descendants of allowed cwd.
TWYLT_GUARDRAILS=1
TWYLT_WORKSPACE_ROOT=/workspace
TWYLT_ALLOWED_CWD=/tmp/toolhub-runs
TOOLHUB_RUN_ROOT=/tmp/toolhub-runs
TWYLT_DISABLE_NETWORK=0
